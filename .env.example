# ==============================================================================
# Dukan Builder / LaneSite Environment Configuration
# ==============================================================================

# --- Database & Supabase (Required) ---
# Postgres connection string (from Supabase Project -> Database -> Connection string pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Project API URL & Keys (from Supabase Project -> Project Settings -> API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_PUBLIC_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_SECRET]"

# 32-byte hex encryption key for site-owner passwords (generated via openssl rand -hex 32)
SITE_ADMIN_ENC_KEY=""

# --- AI & Media Pipeline (Optional / Defaults provided) ---
# Pixabay API Key for stock media (optional, falls back to curated Unsplash images)
PIXABAY_API_KEY=""

# OpenCode CLI binary path
OPENCODE_BIN="/home/ubuntu/.opencode/bin/opencode"

# --- Storage & Workspaces ---
TENANTS_ROOT="/opt/tenants"
PUBLISHED_ROOT="/opt/www/published"
PREVIEW_LINK="/opt/preview/current"
QA_SCRIPT="/home/ubuntu/lanesite.pro/dukan-builder/qa/qa-check.cjs"
TEMPLATE_DIR="/home/ubuntu/lanesite.pro/dukan-builder/template"
UPLOADS_DIR="/home/ubuntu/lanesite.pro/dukan-builder/data/uploads"
