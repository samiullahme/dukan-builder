{
	admin off
	on_demand_tls {
		ask http://127.0.0.1:8089
	}
}

(common) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

builder.lanesite.pro, builder.dukanbot.website {
	import common
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3010
}

preview.lanesite.pro, preview.dukanbot.website {
	import common
	tls {
		on_demand
	}
	handle /_api/* {
		reverse_proxy 127.0.0.1:3010
	}
	handle {
		root * /opt/preview-current
		@indexHtml path /index.html
		redir @indexHtml / 301
		@extHtml path_regexp html ^/(.+)\.html$
		redir @extHtml /{re.html.1} 301
		try_files {path} {path}.html {path}/ =404
		file_server
	}
}

# Client subdomains: <slug>.lanesite.pro -> /opt/www/published/<slug>
# Wildcard DNS (*.lanesite.pro) must point here. TLS certs auto-issued on first visit.
*.lanesite.pro, *.dukanbot.website {
	import common
	tls {
		on_demand
	}
	map {http.request.host} {slug} {
		~^(?P<sub>[a-z0-9-]+)\.(lanesite\.pro|dukanbot\.website)$ ${sub}
		default ""
	}
	handle /_api/* {
		reverse_proxy 127.0.0.1:3010
	}
	handle {
		root * /opt/www/published/{slug}
		@indexHtml path /index.html
		redir @indexHtml / 301
		@extHtml path_regexp html ^/(.+)\.html$
		redir @extHtml /{re.html.1} 301
		try_files {path} {path}.html {path}/ =404
		file_server
	}
}
